      "id": "py-context",
      "difficulty": "advanced",
      "lines": [
        "from contextlib import contextmanager",
        "",
        "@contextmanager",
        "def swallow(*errors):",
        "    try:",
        "        yield",
        "    except errors as err:",
        "        print(f\"ignored: {err!r}\")"
      ]
    },
