      "difficulty": "intermediate",
      "lines": [
        "class Timer:",
        "    def __init__(self, label):",
        "        self.label = label",
        "        self.elapsed = 0.0",
        "",
        "    def tick(self, dt):",
        "        self.elapsed += dt",
        "        return self.elapsed"
      ]
