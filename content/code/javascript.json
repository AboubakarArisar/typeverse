      "id": "js-sum",
      "difficulty": "beginner",
      "lines": [
        "function sum(numbers) {",
        "  let total = 0;",
        "  for (const n of numbers) {",
        "    total += n;",
        "  }",
        "  return total;",
        "}"
      ]
    },
