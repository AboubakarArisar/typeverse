# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

# Keep shell scripts LF even on Windows checkouts.
*.sh text eol=lf

# Binary assets: never diff or convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.zip binary

# Generated; collapse in pull request diffs.
package-lock.json linguist-generated=true -diff
