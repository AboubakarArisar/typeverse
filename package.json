{
  "name": "typeverse",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "validate:content": "vitest run tests/unit/content.test.ts"
  },
  "dependencies": {
    "@preact/signals": "2.0.3",
    "idb-keyval": "6.2.1",
    "preact": "10.26.4",
    "uplot": "1.6.31",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@preact/preset-vite": "2.10.1",
    "@types/node": "22.13.14",
    "@vitest/coverage-v8": "3.0.9",
    "eslint": "9.23.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.28.0",
    "vite": "6.2.3",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "3.0.9"
  }
}
